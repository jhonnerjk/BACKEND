# Backend Environment Variables
# Copia este archivo como .env y completa con tus valores reales

# MongoDB Connection (usa MongoDB Atlas para producción)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/centro_innovacion_udi?retryWrites=true&w=majority

# JWT Secret (genera uno seguro con: openssl rand -base64 32)
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_cambiar_esto

# Puerto del servidor
PORT=4000

# URL del frontend (cambia esto según tu despliegue)
# Desarrollo: http://localhost:5173
# Producción: https://tu-app.vercel.app
FRONTEND_URL=https://tu-app.vercel.app

# Entorno de ejecución
NODE_ENV=production
